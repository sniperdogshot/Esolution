# Variáveis do site (TanStack Start). Copie para .env.local e preencha.
# Em produção, configure no painel da Netlify (Site settings > Environment variables).
# Nunca coloque valores reais neste arquivo: ele vai para o Git.

# Senha de acesso ao painel /admin.
ADMIN_PASSWORD=

# Segredo que assina o cookie de sessão do admin (texto aleatório longo).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Se ficar vazio, a sessão é assinada com a ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Banco PostgreSQL com a tabela "atendimentos" (o mesmo do whatsapp-bot).
# Sem ela, o painel mostra dados de exemplo em desenvolvimento e dá erro em produção.
# Local, com o docker-compose: postgresql://postgres:postgres@localhost:5432/esolution
DATABASE_URL=

# Opcional: ID do Google Analytics 4 (padrão G-ZZ8V9X5L3B).
GOOGLE_ANALYTICS_MEASUREMENT_ID=
