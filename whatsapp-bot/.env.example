# Copie para .env e preencha. O .env nunca deve ir para o Git.

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Token que você define no painel da Meta ao cadastrar o webhook
VERIFY_TOKEN=

# "Chave secreta do app" (Meta for Developers > Configurações > Básico).
# Usada para validar a assinatura de cada mensagem recebida.
APP_SECRET=

# Token de acesso e ID do número (Meta for Developers > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Número que recebe o resumo de cada lead finalizado (só dígitos, com 55 e DDD).
# Deixe vazio para não notificar.
NOTIFY_PHONE=

# Deixe 1 apenas em desenvolvimento: habilita a rota /testar
ENABLE_TEST_ROUTE=0
